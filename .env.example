# Copy to .env for local development (`npm run dev:api` + `npm run dev`).
# On Vercel, set these as Project Settings -> Environment Variables instead
# of a .env file - see README.md for the full list and how KV storage plugs
# in automatically once you add it from the Vercel Storage tab.

# Secret used to sign login tokens. MUST be a long random string in
# production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# How long a login stays valid before the user must sign in again.
JWT_EXPIRES_IN=12h

# The very first user, created automatically the first time the API runs
# and no users exist yet. Change the password immediately after first
# login (via "ניהול משתמשים" in the site), then these two lines can be
# removed - they only matter for that one-time bootstrap.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
