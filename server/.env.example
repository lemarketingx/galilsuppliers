# Copy this file to .env and fill in real values before starting the server.

# Port the auth server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your site's URL).
# Use * only for local testing.
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. MUST be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# How long a login stays valid before the user must sign in again.
JWT_EXPIRES_IN=12h

# Created automatically on first boot if no users exist yet.
# Change the password immediately after first login, then these two
# variables can be removed from .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
